# --- Database ---
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=bratislava_events
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://events:events@postgres:5432/bratislava_events

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=events

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Crawler ---
CRAWLER_USER_AGENT=BratislavaEventsBot/0.1 (+https://example.com/bot)
DEFAULT_CITY=Bratislava
DEFAULT_TIMEZONE=Europe/Bratislava
