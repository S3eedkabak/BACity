FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-social.txt ./
RUN pip install --no-cache-dir -r requirements-social.txt
RUN useradd --uid 10003 --user-group --create-home bacitystaff
COPY app ./app
USER 10003:10003
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["uvicorn", "app.social.main:app", "--host", "0.0.0.0", "--port", "8011", "--no-proxy-headers", "--no-access-log"]
