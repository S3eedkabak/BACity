{
    "expo": {
      "name": "Bratislava Events",
      "slug": "bratislava-events",
      "scheme": "bratislava-events",
      "version": "0.1.0",
      "orientation": "portrait",
      "userInterfaceStyle": "dark",
      "newArchEnabled": true,
      "icon": "./assets/icon.png",
      "splash": {
        "backgroundColor": "#0B0C10"
      },
      "assetBundlePatterns": ["**/*"],
      "ios": {
        "supportsTablet": true,
        "bundleIdentifier": "com.bratislavaevents.app",
        "config": {
          "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_KEY"
        }
      },
      "android": {
        "package": "com.bratislavaevents.app",
        "config": {
          "googleMaps": {
            "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_KEY"
          }
        }
      },
      "plugins": ["expo-router", "expo-secure-store"],
      "extra": {
        "router": { "origin": false }
      }
    }
  }