{
  "expo": {
    "name": "Bratislava Events",
    "slug": "bratislava-events",
    "scheme": "bratislava-events",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#100E12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bratislavaevents.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bratislavaevents.app",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "deploymentTarget": "14.0" } }],
      "./plugins/withRiveAsset",
      "expo-router",
      "expo-secure-store",
      "react-native-iap",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BACity to choose and crop your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BACity to use your approximate location for nearby event recommendations."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2bcd249b-9540-4b58-9f09-90a245e0be6e"
      }
    }
  }
}
