# --- Database ---
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=bratislava_events
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://events:events@postgres:5432/bratislava_events

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=events

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:8081
# HTTPS web/universal-link base for /account?action=verify|reset links.
# Development may use bratislava-events:// or the Expo web URL.
ACCOUNT_ACTION_BASE_URL=http://localhost:8081

# --- Social sign-in ---
# The provider callbacks below must be registered in the Google/Apple consoles.
# Google can use localhost for local testing. Apple web sign-in requires an
# HTTPS callback, so use staging or a trusted HTTPS tunnel for Android/local QA.
OAUTH_CALLBACK_BASE_URL=http://localhost:8000
OAUTH_APP_REDIRECT_URI=bratislava-events://oauth

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Public mobile build values. These are OAuth client identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Apple web Service ID + Sign in with Apple key details.
APPLE_OAUTH_CLIENT_ID=
APPLE_IOS_CLIENT_ID=com.bratislavaevents.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Keep PEM newlines escaped as \n when stored on one env-file line.
APPLE_PRIVATE_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
# Mandatory outside development. Inject from secret management; do not commit keys.
# JSON map of key IDs to standard-base64 32-byte AES keys, plus the active ID.
# Stop API/maintenance, backfill existing rows with python -m app.private_data --apply,
# then verify with python -m app.private_data before starting encrypted deployments.
PRIVATE_DATA_KEYS=
PRIVATE_DATA_ACTIVE_KEY=
# Owner-approved published documents and monitored contact; never invented defaults.
PRIVACY_CONTACT_EMAIL=
CONTROLLER_LEGAL_NAME=
BUSINESS_ADDRESS=
SUPPORT_CONTACT_EMAIL=
LEGAL_CONTACT_EMAIL=
# Internal operational escalation; never returned by the public privacy API.
OPERATIONS_CONTACT_EMAIL=
PRIVACY_NOTICE_URL=
PRIVACY_NOTICE_VERSION=
TERMS_URL=
TERMS_VERSION=

# Optional SMTP. For local mail: compose --profile dev-mail up, SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_STARTTLS=false; read messages at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@your-domain.example
MAIL_FROM_NAME=BACity
MESSAGE_RETENTION_DAYS=90
UTILITY_SYNC_ENABLED=false
UTILITY_SYNC_INTERVAL_HOURS=24
MEDIA_ROOT=/data/media

# Optional hosted Stripe billing. Create your own recurring prices; no default prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Consumer BACity+ web billing. Keep disabled until every TEST/LIVE value is configured.
CONSUMER_BILLING_ENABLED=false
STRIPE_CONSUMER_SECRET_KEY=
STRIPE_CONSUMER_WEBHOOK_SECRET=
STRIPE_CONSUMER_PLUS_PRICE_ID=
STRIPE_CONSUMER_PLUS_PRODUCT_ID=
STRIPE_CONSUMER_SUCCESS_URL=http://localhost:8081/plus?billing=success
STRIPE_CONSUMER_CANCEL_URL=http://localhost:8081/plus?billing=cancelled
STRIPE_CONSUMER_PORTAL_RETURN_URL=http://localhost:8081/plus
STRIPE_CONSUMER_LIVEMODE=false
# Deliberately pinned for the consumer integration; organization billing is unchanged.
STRIPE_CONSUMER_API_VERSION=2024-06-20

# Consumer BACity+ Android billing. The service-account JSON is a backend-only
# secret and should be injected by the deployment secret manager as one line.
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.bratislavaevents.app
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=
GOOGLE_PLAY_BASE_PLAN_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Optional authenticated Pub/Sub push identity. Configure both or neither.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Local-only consumer entitlement helper. The API refuses this outside development.
ENABLE_DEVELOPMENT_PLUS_GRANTS=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Crawler ---
CRAWLER_USER_AGENT=BACityBot/1.0 (+https://github.com/S3eedkabak/BACity)
API_BASE_URL=http://localhost:8000
INGESTION_API_KEY=replace-with-a-long-random-secret
CRAWLER_MAX_DEPTH=3
# 0 uses source-specific schedules (2h / 6h / 12h). Minimum override: 15 minutes.
CRAWLER_INTERVAL_MINUTES=0
CRAWLER_MAX_LINKS=50
CRAWLER_MAX_NEW_SOURCES=20
CRAWLER_MAX_SOURCES=250
CRAWLER_JOB_TIMEOUT=900
CRAWLER_BLOCK_DOMAINS=facebook.com,instagram.com,twitter.com,x.com,youtube.com
CRAWLER_ALLOW_DOMAINS=
DEFAULT_CITY=Bratislava
DEFAULT_TIMEZONE=Europe/Bratislava
