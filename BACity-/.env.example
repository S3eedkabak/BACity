# --- Database ---
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=bratislava_events
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://events:events@postgres:5432/bratislava_events

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=events

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:8081

# Optional SMTP. For local mail: compose --profile dev-mail up, SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_STARTTLS=false; read messages at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
MESSAGE_RETENTION_DAYS=90

# Optional hosted Stripe billing. Create your own recurring prices; no default prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Crawler ---
CRAWLER_USER_AGENT=BACityBot/1.0 (+https://github.com/S3eedkabak/BACity)
API_BASE_URL=http://localhost:8000
INGESTION_API_KEY=replace-with-a-long-random-secret
CRAWLER_MAX_DEPTH=3
# 0 uses source-specific schedules (2h / 6h / 12h). Minimum override: 15 minutes.
CRAWLER_INTERVAL_MINUTES=0
CRAWLER_MAX_LINKS=50
CRAWLER_MAX_NEW_SOURCES=20
CRAWLER_MAX_SOURCES=250
CRAWLER_JOB_TIMEOUT=900
CRAWLER_BLOCK_DOMAINS=facebook.com,instagram.com,twitter.com,x.com,youtube.com
CRAWLER_ALLOW_DOMAINS=
DEFAULT_CITY=Bratislava
DEFAULT_TIMEZONE=Europe/Bratislava
