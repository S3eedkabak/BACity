# ==========================================
# BACity - Git Ignore
# ==========================================

# ------------------------------------------
# Node / JavaScript
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Expo
# ------------------------------------------
.expo/
.expo-shared/

# Expo web/build output
dist/
web-build/

# ------------------------------------------
# React Native / Android
# ------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/local.properties

# Android generated files
*.iml
.gradle/
captures/
.externalNativeBuild/
.cxx/

# ------------------------------------------
# iOS
# ------------------------------------------
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local

# Xcode user-specific files
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# ------------------------------------------
# Environment variables / secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python packaging
*.egg-info/
.eggs/
pip-wheel-metadata/

# ------------------------------------------
# Databases / local data
# ------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# Build / generated files
# ------------------------------------------
build/
dist/
*.tmp
*.temp

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/

# ------------------------------------------
# macOS
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------
# Windows
# ------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# VS Code
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ------------------------------------------
# JetBrains / IntelliJ
# ------------------------------------------
.idea/
*.iml

# ------------------------------------------
# Temporary / OS files
# ------------------------------------------
*.swp
*.swo
*~

# User-uploaded media is runtime data, never source control.
services/api/media/
